{
  "asyncapi": "3.0.0",
  "id": "urn:smartai:asyncapi:events:v1",
  "info": {
    "title": "SmartAI Platform Events",
    "version": "1.0.0",
    "description": "SmartAI 跨模块、跨运行时异步消息契约。平台消息使用本契约；Celery 私有 task protocol 不属于本契约，必须由 ai-dispatcher 与 AICommand/AIResult 互相转换。"
  },
  "defaultContentType": "application/json",
  "servers": {
    "rabbitmq": {
      "host": "rabbitmq.internal:5671",
      "protocol": "amqps",
      "description": "生产地址由部署配置覆盖。服务身份按 exchange 和 queue 授予最小权限。",
      "security": [
        {
          "$ref": "#/components/securitySchemes/mutualTls"
        }
      ],
      "bindings": {
        "amqp": {
          "vhost": "/smartai",
          "bindingVersion": "0.3.0"
        }
      }
    }
  },
  "channels": {
    "integrationNormalizedV1": {
      "address": "integration.normalized.v1.{sourceSystem}.{resourceType}.{eventName}",
      "title": "归一化外部 Webhook 事件",
      "description": "连接器完成验签、原始事件落库和供应商字段归一化后发布。供应商事件不得直接写入核心聚合。",
      "parameters": {
        "sourceSystem": {
          "description": "标准化来源系统代码，例如 customer-ats 或 interview-provider。"
        },
        "resourceType": {
          "description": "小写资源类型，例如 job、application、interview。"
        },
        "eventName": {
          "description": "标准化事件名，例如 updated、completed、rejected。"
        }
      },
      "messages": {
        "NormalizedWebhookEvent": {
          "$ref": "#/components/messages/NormalizedWebhookEvent"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "smartai.integration.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/smartai"
          },
          "bindingVersion": "0.3.0"
        }
      },
      "x-smartai-delivery": {
        "consumerQueue": "smartai.integration.normalized.v1.core",
        "retryDelaysSeconds": [5, 30, 300, 1800, 7200],
        "maxDeliveryAttempts": 5,
        "deadLetterExchange": "smartai.dlx",
        "deadLetterQueue": "smartai.integration.normalized.v1.core.dlq"
      }
    },
    "domainEventsV1": {
      "address": "domain.v1.{boundedContext}.{eventName}",
      "title": "内部领域事件",
      "description": "由业务核心事务内 Outbox 发布的过去式领域事实。每个消费者使用自己的 queue、Inbox 和 DLQ。",
      "parameters": {
        "boundedContext": {
          "description": "限界上下文，例如 recruitment、talent、interview、knowledge。"
        },
        "eventName": {
          "description": "过去式事件名，例如 PositionPlanApproved、MatchRunCompleted。"
        }
      },
      "messages": {
        "DomainEvent": {
          "$ref": "#/components/messages/DomainEvent"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "smartai.domain.events",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/smartai"
          },
          "bindingVersion": "0.3.0"
        }
      },
      "x-smartai-delivery": {
        "consumerQueuePattern": "smartai.domain.v1.{consumerName}",
        "retryDelaysSeconds": [5, 30, 300, 1800, 7200],
        "maxDeliveryAttempts": 5,
        "deadLetterExchange": "smartai.dlx",
        "deadLetterQueuePattern": "smartai.domain.v1.{consumerName}.dlq"
      }
    },
    "aiCommandsV1": {
      "address": "ai.command.v1.{action}",
      "title": "AI 平台命令",
      "description": "Java Core 发往 Python ai-dispatcher 的平台命令。dispatcher 写 Inbox 后才可确认消息，并将命令转换为 Celery 私有任务。",
      "parameters": {
        "action": {
          "description": "动作代码，例如 document.parse、knowledge.index、knowledge.retrieve、talent.retrieve、evidence.extract、content.generate。"
        }
      },
      "messages": {
        "AICommand": {
          "$ref": "#/components/messages/AICommand"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "smartai.ai.commands",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/smartai"
          },
          "bindingVersion": "0.3.0"
        }
      },
      "x-smartai-delivery": {
        "consumerQueue": "smartai.ai.commands.v1.dispatcher",
        "retryScope": "仅保证 dispatcher 幂等接收；计算重试由 Celery 私有队列负责",
        "retryDelaysSeconds": [5, 30, 300, 1800, 7200],
        "maxDeliveryAttempts": 5,
        "deadLetterExchange": "smartai.dlx",
        "deadLetterQueue": "smartai.ai.commands.v1.dispatcher.dlq",
        "celeryBoundary": "dispatcher 使用 tenantId + businessKey 生成稳定 Celery task id；Java 不发布 Celery task protocol"
      }
    },
    "aiResultsV1": {
      "address": "ai.result.v1.{action}.{outcome}",
      "title": "AI 平台结果",
      "description": "Python result-publisher 将 Celery 结果转换为平台结果事件，Java Core 通过 Inbox 幂等消费。",
      "parameters": {
        "action": {
          "description": "与命令一致的动作代码。"
        },
        "outcome": {
          "description": "小写结果：succeeded、partial、failed 或 cancelled。"
        }
      },
      "messages": {
        "AIResult": {
          "$ref": "#/components/messages/AIResult"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "smartai.ai.results",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/smartai"
          },
          "bindingVersion": "0.3.0"
        }
      },
      "x-smartai-delivery": {
        "consumerQueue": "smartai.ai.results.v1.core",
        "retryDelaysSeconds": [5, 30, 300, 1800],
        "maxDeliveryAttempts": 4,
        "deadLetterExchange": "smartai.dlx",
        "deadLetterQueue": "smartai.ai.results.v1.core.dlq"
      }
    },
    "notificationCommandsV1": {
      "address": "notification.command.v1.{channel}.{action}",
      "title": "通知命令",
      "description": "发送模板消息、提醒或撤销操作。收件人和模板变量必须通过加密 payloadRef 传递。",
      "parameters": {
        "channel": {
          "description": "email、sms、enterprise-message 或 provider-defined。"
        },
        "action": {
          "description": "send、remind 或 cancel。"
        }
      },
      "messages": {
        "NotificationCommand": {
          "$ref": "#/components/messages/NotificationCommand"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "smartai.notification.commands",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/smartai"
          },
          "bindingVersion": "0.3.0"
        }
      },
      "x-smartai-delivery": {
        "consumerQueue": "smartai.notification.commands.v1.dispatcher",
        "retryPolicy": "外部结果未知时先查后重试；禁止仅因超时重复发送",
        "retryDelaysSeconds": [30, 300, 1800],
        "maxDeliveryAttempts": 3,
        "deadLetterExchange": "smartai.dlx",
        "deadLetterQueue": "smartai.notification.commands.v1.dispatcher.dlq"
      }
    },
    "notificationResultsV1": {
      "address": "notification.result.v1.{channel}.{outcome}",
      "title": "通知结果",
      "description": "通知渠道返回的受理、送达、退信、失败或未知状态。",
      "parameters": {
        "channel": {
          "description": "标准化消息渠道。"
        },
        "outcome": {
          "description": "accepted、delivered、bounced、failed、cancelled 或 unknown。"
        }
      },
      "messages": {
        "NotificationResult": {
          "$ref": "#/components/messages/NotificationResult"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "smartai.notification.results",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/smartai"
          },
          "bindingVersion": "0.3.0"
        }
      },
      "x-smartai-delivery": {
        "consumerQueue": "smartai.notification.results.v1.core",
        "retryDelaysSeconds": [5, 30, 300, 1800],
        "maxDeliveryAttempts": 4,
        "deadLetterExchange": "smartai.dlx",
        "deadLetterQueue": "smartai.notification.results.v1.core.dlq"
      }
    },
    "connectorResultsV1": {
      "address": "connector.result.v1.{connectorType}.{operation}.{outcome}",
      "title": "连接器操作结果",
      "description": "ATS、人才库、在线面试、消息和审批连接器完成外部操作后发布的标准结果。",
      "parameters": {
        "connectorType": {
          "description": "ats、talent-pool、interview、message、approval 或 rpa。"
        },
        "operation": {
          "description": "标准连接器操作代码。"
        },
        "outcome": {
          "description": "succeeded、partial、failed、conflict 或 unknown。"
        }
      },
      "messages": {
        "ConnectorResult": {
          "$ref": "#/components/messages/ConnectorResult"
        }
      },
      "bindings": {
        "amqp": {
          "is": "routingKey",
          "exchange": {
            "name": "smartai.connector.results",
            "type": "topic",
            "durable": true,
            "autoDelete": false,
            "vhost": "/smartai"
          },
          "bindingVersion": "0.3.0"
        }
      },
      "x-smartai-delivery": {
        "consumerQueue": "smartai.connector.results.v1.core",
        "retryDelaysSeconds": [5, 30, 300, 1800],
        "maxDeliveryAttempts": 4,
        "deadLetterExchange": "smartai.dlx",
        "deadLetterQueue": "smartai.connector.results.v1.core.dlq"
      }
    }
  },
  "operations": {
    "connectorPublishesNormalizedWebhook": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/integrationNormalizedV1"
      },
      "messages": [
        {
          "$ref": "#/channels/integrationNormalizedV1/messages/NormalizedWebhookEvent"
        }
      ]
    },
    "coreConsumesNormalizedWebhook": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/integrationNormalizedV1"
      },
      "messages": [
        {
          "$ref": "#/channels/integrationNormalizedV1/messages/NormalizedWebhookEvent"
        }
      ]
    },
    "corePublishesDomainEvent": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/domainEventsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/domainEventsV1/messages/DomainEvent"
        }
      ]
    },
    "internalConsumerReceivesDomainEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/domainEventsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/domainEventsV1/messages/DomainEvent"
        }
      ]
    },
    "corePublishesAICommand": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/aiCommandsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/aiCommandsV1/messages/AICommand"
        }
      ]
    },
    "aiDispatcherReceivesAICommand": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/aiCommandsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/aiCommandsV1/messages/AICommand"
        }
      ]
    },
    "aiResultPublisherSendsAIResult": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/aiResultsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/aiResultsV1/messages/AIResult"
        }
      ]
    },
    "coreReceivesAIResult": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/aiResultsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/aiResultsV1/messages/AIResult"
        }
      ]
    },
    "corePublishesNotificationCommand": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/notificationCommandsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/notificationCommandsV1/messages/NotificationCommand"
        }
      ]
    },
    "notificationDispatcherReceivesCommand": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/notificationCommandsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/notificationCommandsV1/messages/NotificationCommand"
        }
      ]
    },
    "notificationDispatcherPublishesResult": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/notificationResultsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/notificationResultsV1/messages/NotificationResult"
        }
      ]
    },
    "coreReceivesNotificationResult": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/notificationResultsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/notificationResultsV1/messages/NotificationResult"
        }
      ]
    },
    "connectorPublishesResult": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/connectorResultsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/connectorResultsV1/messages/ConnectorResult"
        }
      ]
    },
    "coreReceivesConnectorResult": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/connectorResultsV1"
      },
      "messages": [
        {
          "$ref": "#/channels/connectorResultsV1/messages/ConnectorResult"
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "mutualTls": {
        "type": "X509",
        "description": "RabbitMQ 服务身份使用客户或平台 CA 签发的短期证书；每个生产者和消费者使用独立身份。"
      }
    },
    "messages": {
      "NormalizedWebhookEvent": {
        "name": "NormalizedWebhookEvent",
        "title": "归一化 Webhook 事件",
        "summary": "保留来源事件和资源版本，由反腐层转换为领域命令或领域事件。",
        "contentType": "application/json",
        "headers": {
          "$ref": "#/components/schemas/CommonHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/NormalizedWebhookEnvelope"
        },
        "correlationId": {
          "location": "$message.payload#/correlationId"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "utf-8",
            "messageType": "smartai.integration.normalized.v1",
            "bindingVersion": "0.3.0"
          }
        }
      },
      "DomainEvent": {
        "name": "DomainEvent",
        "title": "内部领域事件",
        "summary": "由已提交业务事务的 Outbox 发布，事件名使用过去式。",
        "contentType": "application/json",
        "headers": {
          "$ref": "#/components/schemas/CommonHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/DomainEventEnvelope"
        },
        "correlationId": {
          "location": "$message.payload#/correlationId"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "utf-8",
            "messageType": "smartai.domain.event.v1",
            "bindingVersion": "0.3.0"
          }
        }
      },
      "AICommand": {
        "name": "AICommand",
        "title": "AI 平台命令",
        "summary": "引用加密输入对象；不得内联简历、知识正文、面试转写或提示词。",
        "contentType": "application/json",
        "headers": {
          "$ref": "#/components/schemas/CommonHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/AICommandEnvelope"
        },
        "correlationId": {
          "location": "$message.payload#/correlationId"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "utf-8",
            "messageType": "smartai.ai.command.v1",
            "bindingVersion": "0.3.0"
          }
        }
      },
      "AIResult": {
        "name": "AIResult",
        "title": "AI 平台结果",
        "summary": "结果正文通过 payloadRef 返回；失败结果仅携带脱敏错误。",
        "contentType": "application/json",
        "headers": {
          "$ref": "#/components/schemas/CommonHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/AIResultEnvelope"
        },
        "correlationId": {
          "location": "$message.payload#/correlationId"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "utf-8",
            "messageType": "smartai.ai.result.v1",
            "bindingVersion": "0.3.0"
          }
        }
      },
      "NotificationCommand": {
        "name": "NotificationCommand",
        "title": "通知命令",
        "summary": "收件人与模板变量仅存在加密 payloadRef 中。",
        "contentType": "application/json",
        "headers": {
          "$ref": "#/components/schemas/CommonHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/NotificationCommandEnvelope"
        },
        "correlationId": {
          "location": "$message.payload#/correlationId"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "utf-8",
            "messageType": "smartai.notification.command.v1",
            "bindingVersion": "0.3.0"
          }
        }
      },
      "NotificationResult": {
        "name": "NotificationResult",
        "title": "通知结果",
        "summary": "标准化渠道交付状态，不包含联系方式和消息正文。",
        "contentType": "application/json",
        "headers": {
          "$ref": "#/components/schemas/CommonHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/NotificationResultEnvelope"
        },
        "correlationId": {
          "location": "$message.payload#/correlationId"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "utf-8",
            "messageType": "smartai.notification.result.v1",
            "bindingVersion": "0.3.0"
          }
        }
      },
      "ConnectorResult": {
        "name": "ConnectorResult",
        "title": "连接器结果",
        "summary": "标准化外部副作用结果，保留业务操作 ID 和外部资源版本。",
        "contentType": "application/json",
        "headers": {
          "$ref": "#/components/schemas/CommonHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/ConnectorResultEnvelope"
        },
        "correlationId": {
          "location": "$message.payload#/correlationId"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "utf-8",
            "messageType": "smartai.connector.result.v1",
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
    "schemas": {
      "CommonHeaders": {
        "type": "object",
        "required": [
          "content-type",
          "x-smartai-message-id",
          "x-smartai-schema-version",
          "x-smartai-delivery-attempt",
          "traceparent"
        ],
        "properties": {
          "content-type": {
            "const": "application/json"
          },
          "x-smartai-message-id": {
            "type": "string",
            "format": "uuid"
          },
          "x-smartai-schema-version": {
            "type": "string",
            "pattern": "^1\\.[0-9]+$"
          },
          "x-smartai-delivery-attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "x-smartai-first-published-at": {
            "type": "string",
            "format": "date-time"
          },
          "traceparent": {
            "type": "string",
            "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
          },
          "tracestate": {
            "type": "string",
            "maxLength": 512
          }
        },
        "additionalProperties": true,
        "description": "允许 RabbitMQ 注入 x-death、x-first-death-* 等 Broker 头；应用自定义头仍必须使用 x-smartai- 前缀。"
      },
      "BaseEnvelope": {
        "type": "object",
        "required": [
          "messageId",
          "messageClass",
          "type",
          "schemaVersion",
          "tenantId",
          "producer",
          "aggregate",
          "correlationId",
          "causationId",
          "traceparent",
          "businessKey",
          "idempotencyKey",
          "occurredAt",
          "publishedAt",
          "dataClassification"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid",
            "description": "逻辑消息 ID。Broker 重投、延迟重试和重新入队必须保持不变。"
          },
          "messageClass": {
            "type": "string",
            "enum": [
              "INTEGRATION_EVENT",
              "DOMAIN_EVENT",
              "AI_COMMAND",
              "AI_RESULT",
              "NOTIFICATION_COMMAND",
              "NOTIFICATION_RESULT",
              "CONNECTOR_RESULT"
            ]
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]+\\.v1$",
            "maxLength": 120,
            "description": "稳定的消息类型；领域事件使用过去式，命令使用 Requested，具体语态由 CI 命名规则校验。"
          },
          "schemaVersion": {
            "type": "string",
            "pattern": "^1\\.[0-9]+$",
            "description": "消息 Schema 的主次版本。routing key 中的 v1 对应主版本。"
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "producer": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "aggregate": {
            "$ref": "#/components/schemas/ResourceRef"
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "贯穿招聘任务或工作流的关联标识。"
          },
          "causationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "直接触发本消息的命令、消息或 source event 标识。"
          },
          "traceparent": {
            "type": "string",
            "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
          },
          "tracestate": {
